# Environment Mode ('development' or 'production')
ENVIRONMENT=development

# Secret key used to sign JWT tokens (REQUIRED in production)
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here

# PostgreSQL connection string (from Neon/Render)
DATABASE_URL=postgresql://user:password@host/dbname

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://eloquent-one.vercel.app,https://www.eloquent-one.com
ALLOWED_ORIGINS=http://localhost:3000

# Resource Protection & Free-Tier Safeguards
MAX_UPLOAD_SIZE_MB=25
MAX_SESSION_DURATION_SECONDS=300

# Single-Instance Rate Limiting (per minute per IP)
RATE_LIMIT_AUTH_PER_MIN=15
RATE_LIMIT_UPLOADS_PER_MIN=10
RATE_LIMIT_WS_PER_MIN=10
