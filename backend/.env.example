# Eloquent One Backend — Environment Variables
# Copy this file to .env and fill in real values (never commit .env)

# PostgreSQL connection string (from Neon/Render)
DATABASE_URL=postgresql://user:password@host/dbname

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://eloquent-one.vercel.app,https://www.eloquent-one.com
ALLOWED_ORIGINS=http://localhost:3000

# Optional — for future GPT-powered coaching reports
OPENAI_API_KEY=
